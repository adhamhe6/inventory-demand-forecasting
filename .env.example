# Copy to .env and adjust. Never commit real secrets.

# --- Application -------------------------------------------------------------
# production refuses to start with a change-me SECRET_KEY, a published FIRST_ADMIN_PASSWORD,
# SEED_DEMO_DATA=true, DEBUG=true or wildcard CORS.
ENVIRONMENT=development          # development | test | production
LOG_LEVEL=INFO
LOG_JSON=true
# Generate a strong key for anything non-local:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string-of-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- First admin (created on first start if no admin exists) ----------------
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=ChangeMe123!

# Seed a realistic demo dataset (1 year of simulated operations) on first start.
SEED_DEMO_DATA=true

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=inventory
POSTGRES_PASSWORD=inventory-dev-password
POSTGRES_DB=inventory

# --- Ports published on the host -------------------------------------------
WEB_PORT=8080
API_PORT=8000                    # bound to 127.0.0.1 only (direct API / Swagger for local use)
